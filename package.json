{
  "name": "pantry-twin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node scripts/ingest/run.mjs",
    "checks": "npm run typecheck && npm run test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@turf/turf": "^7.4.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
